{
  "manifest_version": 3,
  "name": "Chrome web app external links",
  "version": "1.0",
  "description": "Opens external links from Chrome web app windows with the desktop's default browser.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
